# ──────────────────────────────────────────────────────────────────────
# .env – Local development overrides for AI Red Team tests
# Copy this file to .env and fill in the values.
# In CI these come from GitHub Secrets via the workflow.
# ──────────────────────────────────────────────────────────────────────

# The Azure OpenAI model deployment name (e.g. "Gpt-5-mini")
AZURE_OPENAI_LLM_MODEL=

# The Microsoft Foundry / Azure OpenAI endpoint URL
AZURE_OPENAI_ENDPOINT=

# OAuth2 token endpoint for client credentials flow
AZURE_OPENAI_ACCESS_TOKEN_URL=

# Azure AD tenant ID 
AZURE_OPENAI_TENANT=

# Service principal / app registration client ID
AZURE_OPENAI_CLIENT_ID=

# Service principal client secret
AZURE_OPENAI_CLIENT_SECRET=

# OAuth2 scope for the Azure OpenAI resource
AZURE_OPENAI_SCOPE=
